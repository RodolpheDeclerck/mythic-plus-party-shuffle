REDIS_URL=

NODE_ENV=
DOMAIN=
CORS_ORIGIN=

# OIDC / Auth0 (provider-agnostic)
AUTH_ISSUER_BASE_URL=https://your-tenant.auth0.com/
AUTH_AUDIENCE=https://api.mythic-plus-party-shuffle.com

# Auth0 Token Vault — federated Battle.net token exchange (Custom API Client)
TOKEN_VAULT_CLIENT_ID=
TOKEN_VAULT_CLIENT_SECRET=
TOKEN_VAULT_CONNECTION=battlenet

# Blizzard Profile API (Retail, US region)
BLIZZARD_REGION=us
BLIZZARD_API_HOST=https://us.api.blizzard.com
BLIZZARD_NAMESPACE=profile-us
BLIZZARD_LOCALE=en_US

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Prisma — constructed from POSTGRES_* vars above
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
